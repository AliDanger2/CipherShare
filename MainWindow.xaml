<Window x:Class="CipherShare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CipherShare.ViewModels"
        xmlns:views="clr-namespace:CipherShare.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CipherShare" Height="800" Width="1280" MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        StateChanged="Window_StateChanged">

    <!-- Custom title bar setup. WindowChrome keeps native drag/resize/snap/maximize
         behavior while letting us draw our own title bar instead of the default Windows one.
         CaptionHeight must match the height of the title bar Border below so dragging and
         double-click-to-maximize line up with what's actually drawn on screen. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="5"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DevicesViewModel}">
            <views:DevicesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TransferQueueViewModel}">
            <views:TransferQueueView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

        <!-- Minimize / Maximize-Restore button style: plain placeholder glyphs for now,
             on-theme hover highlight. IsHitTestVisibleInChrome=True is required or WindowChrome
             swallows the click as a "drag the window" gesture instead of a button click. -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Same as above but hovers red, since that's the universally expected "close" cue. -->
        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource DangerBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Thin outer edge so the window still reads as a window against the desktop, now that
         the native chrome/border is gone. x:Name is used to add a small inset margin when
         maximized so content doesn't spill past the visible screen/taskbar - a well-known
         quirk of WindowStyle=None windows, handled in Window_StateChanged below. -->
    <Border x:Name="RootBorder" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============================== custom title bar ============================== -->
            <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                            IsHitTestVisible="False">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="CipherShare" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="- All rights reserved to Erfan Mokhtari &amp; Mohamad Reza Mokhtari"
                               FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="8,1,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                                ToolTip="Minimize"
                                Click="MinimizeButton_Click">
                        <Viewbox Width="12" Height="12">
                            <Path Style="{StaticResource LucideIconStyle}"
                             Data="{StaticResource MinimizeIcon}"/>
                        </Viewbox>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton"
                                Style="{StaticResource TitleBarButtonStyle}"
                                ToolTip="Maximize"
                                Click="MaximizeRestoreButton_Click">
                        <Viewbox Width="12" Height="12">
                            <Path x:Name="MaximizeRestoreIcon"
                                  Style="{StaticResource LucideIconStyle}"
                                  Data="{StaticResource MaximizeIcon}"/>
                        </Viewbox>
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButtonStyle}"
                                ToolTip="Close"
                                Click="CloseButton_Click">
                        <Viewbox Width="12" Height="12">
                            <Path Style="{StaticResource LucideIconStyle}"
                                  Data="{StaticResource CloseIcon}"/>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============================== everything else (unchanged) ============================== -->
            <Grid Grid.Row="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ============================== sidebar ============================== -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                        <DockPanel Margin="16">

                            <!-- This device -->
                            <Border DockPanel.Dock="Bottom" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,4">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Home.DeviceName}" FontWeight="SemiBold" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Home.LocalIpAddress}" FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="14,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Navigation -->
                            <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                                <Button Content="Home" Command="{Binding NavigateCommand}" CommandParameter="Home"
                                        HorizontalContentAlignment="Left">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentNav}" Value="Home">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="Devices" Command="{Binding NavigateCommand}" CommandParameter="Devices"
                                        HorizontalContentAlignment="Left" Margin="0,4,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentNav}" Value="Devices">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Command="{Binding NavigateCommand}" CommandParameter="Queue"
                                        HorizontalContentAlignment="Left" Margin="0,4,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentNav}" Value="Queue">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Transfer Queue"/>
                                        <Border Background="{StaticResource AccentBrush}" CornerRadius="8" Padding="6,1" Margin="8,0,0,0"
                                                Visibility="{Binding Queue.ActiveCount, Converter={StaticResource CountToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Queue.ActiveCount}" FontSize="10" FontWeight="Bold" Foreground="#0D1117"/>
                                        </Border>
                                    </StackPanel>
                                </Button>

                                <Button Content="History" Command="{Binding NavigateCommand}" CommandParameter="History"
                                        HorizontalContentAlignment="Left" Margin="0,4,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentNav}" Value="History">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Content="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                        HorizontalContentAlignment="Left" Margin="0,4,0,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentNav}" Value="Settings">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                        </DockPanel>
                    </Border>

                    <!-- ============================== content ============================== -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid Margin="24,0">
                                <Button x:Name="BellButton"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource IconButtonStyle}"
                                            Width="36"
                                            Height="36"
                                            Command="{Binding ToggleNotificationsPanelCommand}">
                                    <Grid>
                                        <Viewbox Width="18"
                                                 Height="18"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Path Style="{StaticResource LucideIconStyle}"
                                                      Data="{StaticResource BellIcon}"/>
                                        </Viewbox>
                                        <Border Background="{StaticResource DangerBrush}"
                                                CornerRadius="7"
                                                Width="14"
                                                Height="14"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Margin="0,-6,-6,0"
                                                Visibility="{Binding UnreadCount, Converter={StaticResource CountToVisibilityConverter}}">

                                            <TextBlock Text="{Binding UnreadCount}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Button>

                                <Popup IsOpen="{Binding IsNotificationsPanelOpen}" PlacementTarget="{Binding ElementName=BellButton}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Style="{StaticResource CardBorderStyle}" Width="320" MaxHeight="420" Margin="0,6,0,0">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                                <TextBlock Text="Notifications" FontWeight="SemiBold"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="Mark all read" Style="{StaticResource GhostButtonStyle}"
                                                            Padding="4,2" FontSize="11"
                                                            Command="{Binding MarkAllNotificationsReadCommand}"/>
                                                    <Button Content="Clear" Style="{StaticResource GhostButtonStyle}"
                                                            Padding="4,2" FontSize="11" Margin="4,0,0,0"
                                                            Command="{Binding ClearNotificationsCommand}"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock DockPanel.Dock="Top" Text="No notifications yet." FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       Visibility="{Binding Notifications.Count, Converter={StaticResource ZeroCountToVisibilityConverter}}"/>

                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Notifications}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                                                    Padding="0,8" Cursor="Hand">
                                                                <Border.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick"
                                                                                  Command="{Binding DataContext.MarkNotificationReadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                  CommandParameter="{Binding}"/>
                                                                </Border.InputBindings>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                                               Opacity="{Binding IsRead, Converter={StaticResource ReadOpacityConverter}}"/>
                                                                    <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                                                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                                    <TextBlock Text="{Binding CreatedAtUtc, Converter={StaticResource RelativeTimeConverter}}"
                                                                               FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="24"/>
                    </Grid>
                </Grid>

                <!-- ============================== toast overlay ============================== -->
                <ItemsControl ItemsSource="{Binding ActiveToasts}" Panel.ZIndex="1000"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                              IsHitTestVisible="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}" Width="300" Margin="0,6,0,0" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Border>
</Window>
