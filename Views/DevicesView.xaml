<UserControl x:Class="CipherShare.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CipherShare.Views.Controls">

    <UserControl.Resources>
        <DataTemplate x:Key="DeviceCardTemplate">
            <controls:DeviceCardControl Margin="0,0,12,12"
                SendFilesCommand="{Binding DataContext.SendFilesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                ToggleTrustCommand="{Binding DataContext.State.ToggleDeviceTrustCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                RemoveCommand="{Binding DataContext.State.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <TextBlock Text="Discovered now" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock Text="Nothing on the network right now. Devices show up here automatically once they're found."
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"
                       Visibility="{Binding DiscoveredDevices.Count, Converter={StaticResource ZeroCountToVisibilityConverter}}"/>
            <ItemsControl ItemsSource="{Binding DiscoveredDevices}"
                          ItemsPanel="{StaticResource WrapPanelTemplate}"
                          ItemTemplate="{StaticResource DeviceCardTemplate}" Margin="0,0,0,24"/>

            <TextBlock Text="Trusted devices" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock Text="Mark a device as trusted from its card to skip the accept dialog for it (if your security setting allows that)."
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"
                       Visibility="{Binding TrustedDevices.Count, Converter={StaticResource ZeroCountToVisibilityConverter}}"/>
            <ItemsControl ItemsSource="{Binding TrustedDevices}"
                          ItemsPanel="{StaticResource WrapPanelTemplate}"
                          ItemTemplate="{StaticResource DeviceCardTemplate}" Margin="0,0,0,24"/>

            <TextBlock Text="Recently seen" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock Text="Devices that were online before but aren't responding right now."
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"
                       Visibility="{Binding RecentDevices.Count, Converter={StaticResource ZeroCountToVisibilityConverter}}"/>
            <ItemsControl ItemsSource="{Binding RecentDevices}"
                          ItemsPanel="{StaticResource WrapPanelTemplate}"
                          ItemTemplate="{StaticResource DeviceCardTemplate}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
