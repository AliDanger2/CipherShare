<Window x:Class="CipherShare.Views.Dialogs.IncomingTransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Incoming transfer" Height="320" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        Topmost="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Incoming file transfer" FontSize="17" FontWeight="Bold"/>
            <TextBlock Text="{Binding SenderLabel, StringFormat='from {0}'}" FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0" VerticalAlignment="Top">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Files" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding FileCount}" FontSize="12" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Total size" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding TotalSize, Converter={StaticResource BytesToStringConverter}}"
                               FontSize="12" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>

                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding Request.Files}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding RelativePath}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,16,0,0">
            <Button Content="Decline" Style="{StaticResource DangerButtonStyle}" Padding="14,10"
                    HorizontalAlignment="Left" Command="{Binding DeclineCommand}"/>
            <Button Content="Accept" Style="{StaticResource PrimaryButtonStyle}" Padding="18,10" Margin="8,0,0,0"
                    HorizontalAlignment="Left" Command="{Binding AcceptCommand}"/>
        </StackPanel>
    </Grid>
</Window>
