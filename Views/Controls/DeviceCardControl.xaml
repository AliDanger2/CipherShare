<UserControl x:Class="CipherShare.Views.Controls.DeviceCardControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="260">
    <Border Style="{StaticResource CardBorderStyle}">
        <StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Margin="0,0,8,0"
                             Fill="{Binding Status, Converter={StaticResource DeviceStatusToBrushConverter}}"/>
                    <Viewbox Width="15" Height="15" Margin="0,0,6,0"
                             ToolTip="{Binding DeviceType, Converter={StaticResource DeviceTypeToLabelConverter}}">
                        <Path Data="{Binding DeviceType, Converter={StaticResource DeviceTypeToIconConverter}}"
                              Style="{StaticResource LucideIconStyle}"
                              Stroke="{StaticResource TextSecondaryBrush}"/>
                    </Viewbox>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                               TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                </StackPanel>
                <Viewbox Width="14"
                         Height="14"
                         HorizontalAlignment="Right"
                         Visibility="{Binding IsTrusted, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Path Data="{StaticResource StarIcon}"
                          Style="{StaticResource LucideIconStyle}"
                          Stroke="{StaticResource WarningBrush}"/>
                </Viewbox>
            </Grid>

            <TextBlock Text="{Binding IpAddress}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="38,4,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="38,2,0,0">
                <TextBlock Text="{Binding OsType}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="{Binding Status, Converter={StaticResource DeviceStatusToLabelConverter}}"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="Send Files" Style="{StaticResource PrimaryButtonStyle}"
                        Padding="12,6" FontSize="12"
                        IsEnabled="{Binding Status, Converter={StaticResource DeviceIsReachableConverter}}"
                        Command="{Binding SendFilesCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                <Button Content="{Binding IsTrusted, Converter={StaticResource TrustLabelConverter}}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,6" FontSize="12" Margin="6,0,0,0"
                        Command="{Binding ToggleTrustCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                <Button Style="{StaticResource IconButtonStyle}"
                            Width="28"
                            Height="28"
                            Margin="6,0,0,0"
                            ToolTip="Forget this device"
                            Command="{Binding RemoveCommand, ElementName=Root}"
                            CommandParameter="{Binding}">
                    <Viewbox Width="14"
                             Height="14">
                        <Path Data="{StaticResource TrashIcon}"
                                  Style="{StaticResource LucideIconStyle}"/>
                    </Viewbox>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>