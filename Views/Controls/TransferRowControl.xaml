<UserControl x:Class="CipherShare.Views.Controls.TransferRowControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorderStyle}" Padding="14" Margin="0,0,0,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- direction glyph -->
            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                    Background="{StaticResource SurfaceHoverBrush}" Margin="0,0,12,0" VerticalAlignment="Top">
                <Viewbox Width="16"
                         Height="16"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">
                    <Path Stroke="{StaticResource AccentBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Data" Value="{StaticResource ArrowUpIcon}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Direction}" Value="Received">
                                        <Setter Property="Data" Value="{StaticResource ArrowDownIcon}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Viewbox>
            </Border>

            <!-- middle: name, peer, progress -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Grid>
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center"
                                 Fill="{Binding Status, Converter={StaticResource TransferStatusToBrushConverter}}"/>
                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Grid>

                <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text">
                                <Setter.Value>
                                    <MultiBinding StringFormat="To {0} · {1} item(s) · {2}">
                                        <Binding Path="ReceiverName"/>
                                        <Binding Path="ItemCount"/>
                                        <Binding Path="TotalBytes" Converter="{StaticResource BytesToStringConverter}"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Direction}" Value="Received">
                                    <Setter Property="Text">
                                        <Setter.Value>
                                            <MultiBinding StringFormat="From {0} · {1} item(s) · {2}">
                                                <Binding Path="SenderName"/>
                                                <Binding Path="ItemCount"/>
                                                <Binding Path="TotalBytes" Converter="{StaticResource BytesToStringConverter}"/>
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Style="{StaticResource ThinProgressBarStyle}"
                                 Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                 VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding SpeedMBps, Converter={StaticResource SpeedToStringConverter}}"/>
                </Grid>

                <TextBlock FontSize="11" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="{Binding ErrorMessage}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource CountToVisibilityConverter}}"/>
            </StackPanel>

            <!-- actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button ToolTip="Pause" Command="{Binding PauseCommand, ElementName=Root}" CommandParameter="{Binding}">
                    <Viewbox Width="14" Height="14">
                        <Path Style="{StaticResource LucideIconStyle}"
                              Data="{StaticResource PauseIcon}"/>
                    </Viewbox>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Direction}" Value="Sent"/>
                                        <Condition Binding="{Binding Status}" Value="Active"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button ToolTip="Resume" Margin="4,0,0,0"
                        Command="{Binding ResumeCommand, ElementName=Root}" CommandParameter="{Binding}">
                    <Viewbox Width="14" Height="14">
                        <Path Style="{StaticResource LucideIconStyle}"
                              Data="{StaticResource PlayIcon}"/>
                    </Viewbox>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Direction}" Value="Sent"/>
                                        <Condition Binding="{Binding Status}" Value="Paused"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button ToolTip="Cancel" Margin="4,0,0,0"
                        Command="{Binding CancelCommand, ElementName=Root}" CommandParameter="{Binding}">
                    <Viewbox Width="14" Height="14">
                        <Path Style="{StaticResource LucideIconStyle}"
                              Data="{StaticResource CloseIcon}"/>
                    </Viewbox>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Active">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Paused">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button ToolTip="Retry" Margin="4,0,0,0"
                        Command="{Binding RetryCommand, ElementName=Root}" CommandParameter="{Binding}">
                    <Viewbox Width="14" Height="14">
                        <Path Style="{StaticResource LucideIconStyle}"
                              Data="{StaticResource RefreshIcon}"/>
                    </Viewbox>
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Status}" Value="Failed"/>
                                        <Condition Binding="{Binding Direction}" Value="Sent"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Status}" Value="Canceled"/>
                                        <Condition Binding="{Binding Direction}" Value="Sent"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
