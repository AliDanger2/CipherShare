<UserControl x:Class="CipherShare.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:common="clr-namespace:CipherShare.Common"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <!-- ============================== downloads & discovery ============================== -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Downloads &amp; discovery" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14"/>

                    <TextBlock Text="Save received files to" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Grid Margin="0,6,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Draft.DownloadLocation, Mode=TwoWay}" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" Command="{Binding BrowseDownloadLocationCommand}"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="Automatic discovery" FontSize="13"/>
                            <TextBlock Text="Broadcast this device and look for others on the network." FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Draft.AutoDiscovery, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================== network ============================== -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Network" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Network adapter" FontSize="13"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0">
                                <Run Text="Which adapter to announce and listen on. On machines with virtual adapters (VMware, VirtualBox, Hyper-V, etc.) 'Automatic' can occasionally pick the wrong one, which stops other devices from finding you - pick your real Wi-Fi/Ethernet adapter here if that happens."/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding AdapterOptions}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectedValue="{Binding Draft.PreferredAdapterId, Mode=TwoWay}"/>
                        <Button Grid.Column="1" Content="Refresh" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" Command="{Binding RefreshAdaptersCommand}"/>
                    </Grid>
                    <TextBlock Margin="0,0,0,16" FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="Resolves to:"/>
                        <Run Text="{Binding DetectedIpAddress, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Network port" FontSize="13"/>
                            <TextBlock Text="Used for both discovery and file transfer. Change this if it conflicts with another app."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Draft.NetworkPort, Mode=TwoWay}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Broadcast interval (seconds)" FontSize="13"/>
                            <TextBlock Text="How often this device announces itself on the network." FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Draft.BroadcastIntervalSeconds, Mode=TwoWay}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Chunk size (KB)" FontSize="13"/>
                            <TextBlock Text="How much data is read/sent per network operation. Larger can be faster on a stable LAN."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Draft.ChunkSizeKB, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================== transfers ============================== -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Transfers" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Maximum simultaneous transfers" FontSize="13" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Draft.MaxSimultaneousTransfers, Mode=TwoWay}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Bandwidth limit (MB/s)" FontSize="13"/>
                            <TextBlock Text="0 means unlimited." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Draft.BandwidthLimitMBps, Mode=TwoWay}"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="Verify file integrity" FontSize="13"/>
                            <TextBlock Text="Compare a checksum after each file to make sure nothing was corrupted in transit."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Draft.VerifyIntegrity, Mode=TwoWay}"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Keep partial files if a transfer fails" FontSize="13"/>
                            <TextBlock Text="When off, an incomplete file from a failed/canceled transfer is deleted instead of left on disk."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Draft.KeepPartialFilesOnFailure, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================== security ============================== -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Security" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14"/>
                    <TextBlock Text="Incoming transfer confirmation" FontSize="13" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding SecurityLevelOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Draft.SecurityLevel, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="300"/>
                </StackPanel>
            </Border>

            <!-- ============================== notifications ============================== -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Notifications" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="New device discovered" FontSize="13" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Draft.NotifyDeviceDiscovered, Mode=TwoWay}"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Incoming transfer request" FontSize="13" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Draft.NotifyIncomingTransfer, Mode=TwoWay}"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Transfer completed" FontSize="13" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Draft.NotifyTransferComplete, Mode=TwoWay}"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Transfer failed" FontSize="13" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Draft.NotifyTransferFailed, Mode=TwoWay}"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Connection lost" FontSize="13" VerticalAlignment="Center"/>
                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right"
                                  IsChecked="{Binding Draft.NotifyConnectionLost, Mode=TwoWay}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================== save ============================== -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,40">
                <Button Content="Save Changes" Style="{StaticResource PrimaryButtonStyle}" Padding="18,10"
                        Command="{Binding SaveCommand}"/>
                <Button Content="Discard" Style="{StaticResource GhostButtonStyle}" Padding="14,10" Margin="8,0,0,0"
                        Command="{Binding ResetCommand}"/>
                <TextBlock Text="{Binding SavedMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="12"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>

            <TextBlock Text="{x:Static common:AppCredits.FullCredit}"
               FontSize="10" Foreground="{StaticResource TextMutedBrush}"
               HorizontalAlignment="Left" Margin="0,0,0,20"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
