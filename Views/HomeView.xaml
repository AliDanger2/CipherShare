<UserControl x:Class="CipherShare.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CipherShare.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- ============================== this device + stats ============================== -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="THIS DEVICE" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding DeviceName}" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="{Binding LocalIpAddress}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="  ·  " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding LocalOsType}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="  ·  port " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding NetworkPort}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="Broadcasting on the network" FontSize="11" Margin="6,0,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding ActiveTransferCount}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="COMPLETED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding CompletedTransferCount}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                                   Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="DISCOVERED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding DiscoveredCount}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="8" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="TRUSTED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding TrustedCount}" FontSize="26" FontWeight="Bold" Margin="0,6,0,0"
                                   Foreground="{StaticResource WarningBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================== nearby devices ============================== -->
            <TextBlock Text="Nearby devices" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <TextBlock Text="No devices found yet. Make sure other computers running CipherShare are on the same network and Wi-Fi/network discovery is allowed through the firewall."
                       TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       Visibility="{Binding NearbyDevices.Count, Converter={StaticResource ZeroCountToVisibilityConverter}, FallbackValue=Collapsed}"
                       Margin="0,0,0,16"/>

            <ItemsControl ItemsSource="{Binding NearbyDevices}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:DeviceCardControl Margin="0,0,12,12"
                            SendFilesCommand="{Binding DataContext.SendFilesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            ToggleTrustCommand="{Binding DataContext.State.ToggleDeviceTrustCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            RemoveCommand="{Binding DataContext.State.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
