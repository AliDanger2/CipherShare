<Application x:Class="CipherShare.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:CipherShare.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters, available anywhere in the app as a static resource -->
            <conv:BytesToStringConverter x:Key="BytesToStringConverter"/>
            <conv:DurationToStringConverter x:Key="DurationToStringConverter"/>
            <conv:RelativeTimeConverter x:Key="RelativeTimeConverter"/>
            <conv:DateTimeToStringConverter x:Key="DateTimeToStringConverter"/>
            <conv:SpeedToStringConverter x:Key="SpeedToStringConverter"/>
            <conv:ReadOpacityConverter x:Key="ReadOpacityConverter"/>
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <conv:ZeroCountToVisibilityConverter x:Key="ZeroCountToVisibilityConverter"/>
            <conv:EqualityToVisibilityConverter x:Key="EqualityToVisibilityConverter"/>
            <conv:EqualityToBoolConverter x:Key="EqualityToBoolConverter"/>
            <conv:DeviceStatusToBrushConverter x:Key="DeviceStatusToBrushConverter"/>
            <conv:DeviceStatusToLabelConverter x:Key="DeviceStatusToLabelConverter"/>
            <conv:DeviceIsReachableConverter x:Key="DeviceIsReachableConverter"/>
            <conv:TrustLabelConverter x:Key="TrustLabelConverter"/>
            <conv:TransferStatusToBrushConverter x:Key="TransferStatusToBrushConverter"/>
            <conv:DeviceTypeToIconConverter x:Key="DeviceTypeToIconConverter"/>
            <conv:DeviceTypeToLabelConverter x:Key="DeviceTypeToLabelConverter"/>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>